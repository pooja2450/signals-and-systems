clc;
clear;
close all;

% Experiment 20: STFT and Wavelet Analysis

% Sampling parameters
Fs = 1000;
t = 0:1/Fs:2-1/Fs;

% Generate non-stationary chirp signal
% Frequency varies linearly from 50 Hz to 300 Hz
x = chirp(t, 50, t(end), 300, 'linear');

% Add a 150 Hz transient burst from 0.8 s to 1.0 s
burst = zeros(size(t));
idx = (t >= 0.8) & (t <= 1.0);

burst(idx) = 0.8 * sin(2*pi*150*t(idx));

% Combined input signal
x = x + burst;

% STFT / Spectrogram parameters
win = hann(128, 'periodic');
noverlap = 112;
nfft = 512;

% Compute Short-Time Fourier Transform
[S, F, Tstft] = spectrogram(x, win, noverlap, nfft, Fs);

% Create figure
figure('Name', 'Experiment 20: STFT and Wavelet Analysis');

% Plot input signal
subplot(3, 1, 1);

plot(t, x, 'b');
grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('Input: Chirp with 150 Hz Transient');

% Plot STFT magnitude spectrogram
subplot(3, 1, 2);

imagesc(Tstft, F, 20*log10(abs(S) + eps));
axis xy;
ylim([0 400]);
colorbar;

xlabel('Time (s)');
ylabel('Frequency (Hz)');
title('STFT Magnitude Spectrogram (dB)');

% Continuous Wavelet Transform
% Requires Wavelet Toolbox
subplot(3, 1, 3);

[wt, fCWT] = cwt(x, Fs);

imagesc(t, fCWT, abs(wt));
axis xy;
ylim([0 400]);
colorbar;

xlabel('Time (s)');
ylabel('Frequency (Hz)');
title('CWT Magnitude Scalogram');

% Display experimental settings
fprintf('Sampling frequency = %d Hz\n', Fs);

fprintf(['STFT window = %d samples; overlap = %d samples; ', ...
    'FFT length = %d\n'], ...
    length(win), noverlap, nfft);

fprintf(['Input contains a chirp from 50 Hz to 300 Hz ', ...
    'and a 150 Hz burst from 0.8 to 1.0 s.\n']);

