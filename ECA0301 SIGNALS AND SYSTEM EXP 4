clc;
clear;
close all;

% Define time vector
t = -1:0.001:1;

% Define input signals
x1 = sin(2*pi*5*t);
x2 = cos(2*pi*5*t);

% Define constants
a = 2;
b = 3;
t0 = 0.2;

% Define system: T(x) = 2x
T = @(x) 2*x;

% Test linearity
lhs = T(a*x1 + b*x2);
rhs = a*T(x1) + b*T(x2);

linError = max(abs(lhs - rhs));

% Test time invariance
xDelay = sin(2*pi*5*(t - t0));

lhsTI = T(xDelay);
rhsTI = T(x1);

% Shift the system output by t0
rhsTIshift = interp1(t, rhsTI, t - t0, 'linear', 0);

tiError = max(abs(lhsTI - rhsTIshift));

% Plot errors
figure;

subplot(2,1,1);
plot(t, lhs - rhs);
grid on;
title('Linearity Error');
xlabel('Time (s)');
ylabel('Error');

subplot(2,1,2);
plot(t, lhsTI - rhsTIshift);
grid on;
title('Time-Invariance Error');
xlabel('Time (s)');
ylabel('Error');

% Display results
fprintf('Linearity error = %g\n', linError);
fprintf('Time-invariance error = %g\n', tiError);
