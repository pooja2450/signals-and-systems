clc;
clear;
close all;

%% 8(ii) Determination of Inverse Laplace Transform for Signal Reconstruction

figure;

% Define symbolic variables
% Requires Symbolic Math Toolbox
syms s t;

% Define the Laplace-domain function
X = 1 / ((s + 2) * (s + 3));

% Calculate the inverse Laplace transform
x = ilaplace(X, s, t);

% Display the result
disp('Inverse Laplace Transform x(t) =');
pretty(x);

% Define the time vector
tt = 0:0.001:5;

% Convert the symbolic expression to numerical values
xx = double(subs(x, t, tt));

% Plot the reconstructed signal
plot(tt, xx, 'LineWidth', 1.2);
grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('Signal Reconstructed using Inverse Laplace Transform');
